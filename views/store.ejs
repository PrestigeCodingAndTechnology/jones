<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#11110f">
    <meta name="jk-api" content="<%= apiEnabled ? 'enabled' : 'disabled' %>">
    <meta name="description" content="Shop premium sneakers from Jones Kicks. Choose EU sizes 40–45, enter delivery details and pay securely online.">
    <meta property="og:title" content="Jones Kicks • Premium Sneakers">
    <meta property="og:description" content="Fresh silhouettes, sizes 40–45 and a smoother way to order.">
    <title>Jones Kicks • Premium Sneakers</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css">
    <link rel="stylesheet" href="/assets/css/styles.css">
    <link rel="icon" type="image/png" sizes="64x64" href="/assets/images/footprint.png">
  </head>
  <body>
    <header id="site-header"></header>
    <main id="app"></main>
    <div class="drawer-backdrop" id="drawer-backdrop"></div>
    <aside class="drawer" id="cart-drawer" aria-label="Shopping bag"></aside>
    <div class="modal-wrap" id="modal-wrap"></div>
    <div class="toast-stack" id="toast-stack" aria-live="polite"></div>
    <footer id="site-footer"></footer>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="/assets/js/app.js" defer></script>
  </body>
</html>
