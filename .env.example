# Application
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
MONGODB_URI=mongodb://127.0.0.1:27017/jones_kicks
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=24

# First administrator (used by npm run seed)
ADMIN_NAME=Jones Kicks Admin
ADMIN_EMAIL=admin@joneskick.com
ADMIN_PASSWORD=change-this-before-production

# Payment: use demo locally, paystack for real transactions
PAYMENT_MODE=demo
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5000/payment/callback

# Order notification email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Jones Kicks <orders@joneskick.com>"
ORDER_NOTIFICATION_EMAIL=

# Optional controls
TRUST_PROXY=0
MAX_UPLOAD_BYTES=1572864
